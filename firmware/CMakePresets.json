{
  "version": 3,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (Nucleo crystal)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug",
      "inherits": "release",
      "displayName": "Debug",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "tcxo",
      "inherits": "release",
      "displayName": "Release with the TCXO (HSE bypass)",
      "binaryDir": "${sourceDir}/build/tcxo",
      "cacheVariables": { "MAG_HSE_BYPASS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "tcxo", "configurePreset": "tcxo" }
  ]
}
