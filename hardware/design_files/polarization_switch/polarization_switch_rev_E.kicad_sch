	(text "CMD_RLY (bus RLY_CMD) high: K_XFER releases; K1 makes ~7 ms later (R3/C8 delay).\nCMD_GATE >= 30 ms later, on 2-4 s. Gate off; CMD_RLY low at +0.5 ms. K1 opens at ~+3.5 ms,\nits NC feeds XFER and the front end transfers the coil (~+12 ms). TUNE (+5 ms), BLANK2\n(+45 ms) and the record (+60 ms) are front-end timing."
		(exclude_from_sim no)
		(at -4139.438 2150.652 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "2da4eae6-ecde-5bc8-a100-f4aff8716676")
	)
