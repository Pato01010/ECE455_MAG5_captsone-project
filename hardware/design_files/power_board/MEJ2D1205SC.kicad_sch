	(text "ISOLATED   (+/-5 V low-noise, ISO_0V)"
		(exclude_from_sim no)
		(at 205.74 45.72 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "132ee9f1-22ba-507b-92ca-7e0990f2932a")
	)
	(text "Design notes\n1. Vin 10.8 - 13.2 V (MEJ2D12xx input range). U1 is unregulated (+/-8..11.5 V); U2/U3 regulate +/-5 V.\n2. Max 100 mA per +/-5 V rail (MEJ2D1209SC = +/-111 mA).\n3. Capacitance on the module outputs: C3+C5+C7 = 33 uF per rail\n4. U1 pin-out 1 +VIN, 2 -VIN, 5 -VOUT, 6 0V, 7 +VOUT (Murata SIP-7).\n5. GND and ISO_0V must never be joined on this board.\n6. U3 exposed pad is IN (-9 V), not ground."
		(exclude_from_sim no)
		(at 53.848 143.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2c62f64f-d34a-5f15-93d8-8117ce0bd988")
	)
	(text "F1 PTC 0.5 A hold, D1 SMAJ15A TVS (clamps > 16.7 V)\nPi filter C1-L1-C2 (f0 = 23 kHz); R4/C9 R-C damper\nkeeps the filter free of peaking (-15 dB @ 45 kHz)"
		(exclude_from_sim no)
		(at 33.02 106.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "36a7fc96-441a-5133-814a-05077096dea1")
	)
	(text "PRIMARY   (12 V, GND)"
		(exclude_from_sim no)
		(at 96.52 45.72 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
